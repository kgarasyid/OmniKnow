{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --ignore-scripts",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/gateway?route=$1"
    }
  ],
  "functions": {
    "api/gateway.js": {
      "includeFiles": ["dist/**", "deployment-data/**"]
    }
  }
}
